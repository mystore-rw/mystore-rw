# MyStore Environment Configuration
# Copy this file to .env and customize the values for your environment

# =============================================================================
# BASIC CONFIGURATION
# =============================================================================

# Application Environment (development, production, test)
NODE_ENV=development

# Server Configuration
PORT=3000
APP_NAME="MyStore"
APP_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/mystore_development

# Database Connection Pool (optional)
# DATABASE_POOL_SIZE=20
# DATABASE_POOL_TIMEOUT=20000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis URL for caching and sessions
REDIS_URL=redis://localhost:6379

# Redis Configuration (optional)
# REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret for authentication tokens (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session Secret for session management (CHANGE THIS IN PRODUCTION)  
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Password Salt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email From Address
EMAIL_FROM=noreply@mystore.com
EMAIL_FROM_NAME="MyStore"

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Storage Provider (local, aws-s3, gcp-storage, azure-blob)
STORAGE_PROVIDER=local

# Local Storage (for development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mystore-assets

# CloudFlare R2 Configuration (if using R2)
# R2_ACCOUNT_ID=your_r2_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=mystore-assets

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Google Analytics
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Google Maps API (for store locator)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Facebook Pixel (for tracking)
# FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# =============================================================================
# API CONFIGURATION  
# =============================================================================

# API Rate Limiting
API_RATE_LIMIT_WINDOW=3600000
API_RATE_LIMIT_MAX=1000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# API Versioning
API_VERSION=v1

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache Provider (redis, memory, none)
CACHE_PROVIDER=redis

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log Format (json, simple)
LOG_FORMAT=simple

# Log to File (true/false)
LOG_TO_FILE=false

# Log File Path
LOG_FILE_PATH=./logs/app.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable Debug Mode
DEBUG=false

# Hot Reload for Development
HOT_RELOAD=true

# Enable GraphQL Playground
GRAPHQL_PLAYGROUND=true

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Sentry DSN for Error Tracking
# SENTRY_DSN=your_sentry_dsn

# New Relic License Key
# NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# DataDog API Key
# DATADOG_API_KEY=your_datadog_api_key

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================

# Search Provider (postgres, elasticsearch, algolia)
SEARCH_PROVIDER=postgres

# Elasticsearch Configuration (if using Elasticsearch)
# ELASTICSEARCH_HOST=localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=password

# Algolia Configuration (if using Algolia)
# ALGOLIA_APP_ID=your_algolia_app_id
# ALGOLIA_ADMIN_KEY=your_algolia_admin_key
# ALGOLIA_SEARCH_KEY=your_algolia_search_key

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
FEATURE_MULTI_VENDOR=false
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_LOYALTY_PROGRAM=false
FEATURE_SUBSCRIPTIONS=false

# =============================================================================
# SOCIAL MEDIA INTEGRATION
# =============================================================================

# Social Login
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret

# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook Settings
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Image Optimization
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000

# Database Query Timeout (in milliseconds)
DB_QUERY_TIMEOUT=30000

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Database URL (for running tests)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/mystore_test

# Test Redis URL
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# The following settings should be overridden in production:

# NODE_ENV=production
# DATABASE_URL=your_production_database_url
# REDIS_URL=your_production_redis_url
# JWT_SECRET=your_production_jwt_secret
# SESSION_SECRET=your_production_session_secret
# APP_URL=https://your-store.com
# STORAGE_PROVIDER=aws-s3
# CACHE_PROVIDER=redis
# LOG_LEVEL=warn
# LOG_TO_FILE=true

# =============================================================================
# NOTES
# =============================================================================
# 
# - Never commit this file with real secrets to version control
# - Use different secrets for each environment
# - Regularly rotate secrets and API keys
# - Use environment-specific values for URLs and endpoints
# - Test your configuration after making changes
#